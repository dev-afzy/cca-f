# IMPORTANT: Prisma does NOT expand the ~ tilde shorthand.
# You MUST use an absolute path here, not ~/...
# Replace /Users/yourname with your actual home directory.
DATABASE_URL="file:/Users/yourname/.cca-f-tutor/cca-f.db"

# Anthropic API key — required for Phase 2 (Tutor + Router agents)
ANTHROPIC_API_KEY=

# Auth.js (NextAuth v5) — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# GitHub OAuth app: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth: https://console.cloud.google.com → Credentials → OAuth client (Web)
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Billing (Phase 1 — metered pay-as-you-go AI tutor). All money in micro-dollars ($1 = 1_000_000).
# CCAF_MARKUP: multiplier over raw Anthropic cost (covers infra + profit). Set after measuring real cost/turn.
CCAF_MARKUP=1.6
# CCAF_TRIAL_MICROS: one-time free credit granted on first login (250000 = $0.25).
CCAF_TRIAL_MICROS=250000
# CCAF_KILL_SWITCH: set to "on" to pause all AI turns (503) without a deploy.
CCAF_KILL_SWITCH=off
# Spend guardrails (per UTC day): per-user billed cap and global at-cost kill cap.
CCAF_DAILY_USER_CAP_MICROS=3000000
CCAF_GLOBAL_DAILY_CAP_MICROS=25000000

# Stripe (Phase 2 — credit-pack top-ups). Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret. Local dev: run `stripe listen --forward-to localhost:3000/api/billing/webhook`
# (the CLI prints whsec_...). Production: create an endpoint for /api/billing/webhook on the
# checkout.session.completed event and copy its signing secret here.
STRIPE_WEBHOOK_SECRET=

# Production DB (Turso hosted libsql). LEAVE BLANK for local dev — the app falls
# back to the on-disk SQLite file at ~/.cca-f-tutor/cca-f.db when these are unset.
# Create a DB: `turso db create cca-f` → `turso db show --url cca-f` (libsql://...)
# and `turso db tokens create cca-f`. Apply migrations to it with the Turso CLI:
#   for d in prisma/migrations/*/; do turso db shell cca-f < "$d/migration.sql"; done
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
